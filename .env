# fp32 gives the best CPU quality. int8 is smaller/faster but needs a VNNI-capable CPU.
TEU_VOICE_PRECISION=fp32

# Safe default. To share on the private LAN, use:
# .\run.ps1 -LanAddress 172.28.0.166
# The script creates a random per-run access key and prints the protected URL.
# Never use 0.0.0.0 or a public IP for private voice cloning.
TEU_VOICE_HOST=127.0.0.1
TEU_VOICE_PORT=8765
